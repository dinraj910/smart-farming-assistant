// Prisma schema for Smart Farming Assistant – chat memory layer
//
// This schema manages ONLY the chat session tables.
// The KAU knowledge base (pgvector embeddings) lives in separate raw-SQL tables
// managed by asyncpg and is NOT touched here.
//
// Note on farmId: ChatSession stores a farmId string for grouping sessions by
// farm. A Farm model has now been created and linked to User.
// A DB-level FK has been added to link ChatSession to Farm.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

enum ChatRole {
  user
  assistant
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions      ChatSession[]
  farms         Farm[]

  @@map("users")
}

model ChatSession {
  id            String   @id @default(uuid()) @db.Uuid
  farmId        String?  @map("farm_id") @db.Uuid
  farm          Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  memorySummary String?  @map("memory_summary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userId        String?  @map("user_id") @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Farm {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  location      String
  acres         String
  npk           String?
  status        String   @default("Inspection Due")
  image         String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions      ChatSession[]

  @@map("farms")
}

// We tell Prisma about the existing KAU pgvector table so it doesn't try to drop it.
// The @@ignore attribute means Prisma Client won't generate CRUD for it (we use asyncpg)
// and 'prisma db push' will leave it alone.
model kau_chunks {
  id          Int                    @id @default(autoincrement())
  content     String
  source_page Int?
  embedding   Unsupported("vector")?

  @@ignore
}